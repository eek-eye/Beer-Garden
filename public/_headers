# Cloudflare Pages response headers. Parsed by Pages — never served as a file itself.
#
# Why this file exists: GitHub Pages cannot send custom response headers at all, so the live
# site sent none. Pages adds Referrer-Policy and X-Content-Type-Options by default; the rest
# below are ours.
#
# CSP caveat: the pages use inline <script> blocks and inline style="" attributes, so
# 'unsafe-inline' is required for script-src and style-src. To tighten that later, move the
# inline blocks into .js/.css files first.
#
# No 'form-action': login.html's forms submit to action="javascript:void(0);" and a
# form-action directive blocks that.
#
# Hosts that must stay allowed (each one was checked in a browser against this policy):
#   script-src  www.gstatic.com      Firebase SDK (app, auth, firestore compat)
#               apis.google.com      gapi, loaded by Firebase Auth for the Google sign-in popup/redirect
#   connect-src *.googleapis.com     Firestore, identitytoolkit, securetoken
#               script.google.com    reservation emails (Apps Script web app) ...
#               script.googleusercontent.com  ... which answers with a 302 here; fetch follows it
#   frame-src   bar-chinesca-mxli.firebaseapp.com  Firebase Auth helper iframe (/__/auth/iframe)
#   style-src / font-src  fonts.googleapis.com / fonts.gstatic.com  decorative fonts after "Aceptar"
#   script-src  static.cloudflareinsights.com  Cloudflare Web Analytics beacon, injected by the zone on
#   connect-src cloudflareinsights.com         barchinesca.club (not on *.pages.dev); it reports to /cdn-cgi/rum
# Rocket Loader must stay off: it rewrites every script and this policy does not allow that.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://script.google.com https://script.googleusercontent.com https://cloudflareinsights.com https://*.firebaseio.com wss://*.firebaseio.com; frame-src https://bar-chinesca-mxli.firebaseapp.com https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Media is the whole page weight, and these filenames are not fingerprinted, so a week
# rather than a year: long enough that repeat visits cost almost nothing, short enough
# that replacing a photo actually shows up.
/IMAGES/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=604800
/vendor/*
  Cache-Control: public, max-age=604800
