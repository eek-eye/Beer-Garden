rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Beer Garden (Bar Chinesca Mxli reservations, eek-eye/Beer-Garden)
    // Firebase project: bar-chinesca-mxli (this project holds only the bar's data)
    //
    //   barReservations/{orderNumber}  one reserved table; private to its owner
    //   barTableLocks/{date_table}     "table T is taken on date D"; public, no personal data
    //   barUserActive/{uid}            the user's reservations that still hold a table: res = {orderNumber: date};
    //                                  the per-account limits are checked on this index (see "Per-account limits")
    //   barUserCounts/{uid}            legacy counter (old 2-per-account limit); no longer written by the site
    //   barCheckins/{code}             QR check-in code of one reservation (random, unguessable);
    //                                  owner + admins can read it, only admins can check it in
    //   barAdmins/{uid}                old staff allowlist by account (written only from the Firebase console;
    //                                  kept for the shared staff login until the owner turns it off)
    //   barStaffEmails/{email}         staff allowlist by Google email (lower-cased), edited only by the owner
    //                                  in the staff app's "Personal" panel
    //   barStaffNames/{nameKey}        names allowed on the shared password login ("Nombre y apellido"),
    //                                  key = lower-case, no accents, single spaces; edited only by the owner
    //   barStaffSessions/{uid}         shared-login sessions: one entry per device with the authorized name
    //                                  typed there; the scanner works for barAdmins accounts only with one
    //   barStaffPresence/{id}          who has the scanner open (heartbeat), one doc per phone: s_{device} for the
    //                                  shared login, g_{uid}_{device} for Google staff; read by the owners (and
    //                                  shared-login names with the «Ver quién está en línea» privilege)
    //   barTableSeated/{date_table}    staff app «Mesas»: table T of night D already checked in (written only in the
    //                                  check-in transaction); no personal data, read only by staff
    //
    // Booking = one transaction/batch that creates the reservation + its lock and
    // adds the order to barUserActive/{uid}. Cancelling = one batch that deletes the
    // reservation + its lock and removes the order from barUserActive. Each write checks
    // the others with getAfter()/existsAfter(), so none of the three can be written on its own.
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function barResPath(orderNumber) {
      return /databases/$(database)/documents/barReservations/$(orderNumber);
    }

    function barLockPath(lockId) {
      return /databases/$(database)/documents/barTableLocks/$(lockId);
    }

    function barCountPath(uid) {
      return /databases/$(database)/documents/barUserCounts/$(uid);
    }

    function barActivePath(uid) {
      return /databases/$(database)/documents/barUserActive/$(uid);
    }

    function barCheckinPath(code) {
      return /databases/$(database)/documents/barCheckins/$(code);
    }

    // The bar's owners (same powers): fuchendeonze@gmail.com with a verified email, and
    // nunezmarbyte@gmail.com signed in with Google with a verified email
    function barOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'fuchendeonze@gmail.com'
            || (request.auth.token.email == 'nunezmarbyte@gmail.com'
                && request.auth.token.firebase.sign_in_provider == 'google.com'));
    }

    function barOwnerEmail(email) {
      return email in ['fuchendeonze@gmail.com', 'nunezmarbyte@gmail.com'];
    }

    // Signed in with Google (not email/password) and Google vouches for the email
    function barGoogleVerified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string;
    }

    // Individual staff: the owner added their Google email to barStaffEmails. Counts only for a Google
    // sign-in with a verified email, so an email/password account created with a staff address gets nothing.
    function barGoogleStaff() {
      return barGoogleVerified()
        && exists(/databases/$(database)/documents/barStaffEmails/$(request.auth.token.email.lower()));
    }

    function barNamePath(nameKey) {
      return /databases/$(database)/documents/barStaffNames/$(nameKey);
    }

    function barSessionPath(uid) {
      return /databases/$(database)/documents/barStaffSessions/$(uid);
    }

    function barIsSharedAccount() {
      return exists(/databases/$(database)/documents/barAdmins/$(request.auth.uid));
    }

    // Shared password login (barAdmins/{uid}, e.g. security21): only after someone typed an authorized name
    // on a device (session with at least one device, last name entered less than 16 hours ago)
    function barSharedStaff() {
      return barIsSharedAccount()
        && exists(barSessionPath(request.auth.uid))
        && get(barSessionPath(request.auth.uid)).data.devices.size() > 0
        && get(barSessionPath(request.auth.uid)).data.lastLoginAt + duration.value(16, 'h') > request.time;
    }

    // ---- Privileges of the shared-login names (owners set them in «Personal») ----
    // barStaffNames/{key}.perms ⊆ ['presence', 'add', 'remove'] («Ver quién está en línea», «Agregar personal»,
    // «Quitar personal»); a missing field = no privileges. The shared login uses them only through the phone that
    // is acting: session.actor = its device id, still signed in (entry < 16 h) with a name that is still listed.
    function barPermsOk(p) {
      return p is list && p.size() <= 3 && p.hasOnly(['presence', 'add', 'remove']);
    }

    function barActorOk(s) {
      return ('actor' in s) && s.actor is string && s.actor in s.devices
        && s.devices[s.actor].at + duration.value(16, 'h') > request.time
        && exists(barNamePath(s.devices[s.actor].nameKey));
    }

    function barActorPerms(s) {
      return barActorOk(s) ? get(barNamePath(s.devices[s.actor].nameKey)).data.get('perms', []) : [];
    }

    function barSharedCan(p) {
      return signedIn() && barIsSharedAccount()
        && exists(barSessionPath(request.auth.uid))
        && p in barActorPerms(get(barSessionPath(request.auth.uid)).data);
    }

    function barSharedCanAny() {
      return barSharedCan('presence') || barSharedCan('add') || barSharedCan('remove');
    }

    // Staff who may verify QR codes at the door: the owner, anyone the owner added in "Personal"
    // (Google sign-in), plus the shared barAdmins/{uid} login once an authorized name was entered
    function isAdmin() {
      return signedIn() && (
        barOwner()
        || barGoogleStaff()
        || barSharedStaff()
      );
    }

    // Who checked the guest in (barCheckins only). Owner / Google staff: optional display name.
    // Shared login: the device's session entry, whose name must still be on the list, less than 16 hours old.
    function barCheckinWhoOk(d) {
      return (barOwner() || barGoogleStaff())
        ? (!('checkedInDevice' in d) && (!('checkedInName' in d) || (d.checkedInName is string && d.checkedInName.size() <= 100)))
        : ('checkedInDevice' in d && d.checkedInDevice is string
           && d.checkedInDevice in get(barSessionPath(request.auth.uid)).data.devices
           && d.checkedInName == get(barSessionPath(request.auth.uid)).data.devices[d.checkedInDevice].name
           && get(barSessionPath(request.auth.uid)).data.devices[d.checkedInDevice].at + duration.value(16, 'h') > request.time
           && exists(barNamePath(get(barSessionPath(request.auth.uid)).data.devices[d.checkedInDevice].nameKey)));
    }

    // BC-XXXXX-YYYYYYYYYYYYYYYY: 5-character short code + 16 random characters (no 0/O/1/I/L)
    function barValidCode(code) {
      return code.matches('^BC-[2-9A-HJKMNP-Z]{5}-[2-9A-HJKMNP-Z]{16}$');
    }

    // ---- Reservation window (Mexicali, America/Tijuana) ----
    // A code works from 7:00 PM until 11:05 PM on the reservation date. At 11:05 PM every
    // unused code expires. Mexicali follows US daylight time:
    // UTC-7 from the 2nd Sunday of March until the 1st Sunday of November, UTC-8 otherwise.
    // Same calculation as script.js and the staff app.
    function barMxOffsetMinYMD(y, m, d) {
      let secondSundayMarch = 8 + (7 - timestamp.date(y, 3, 1).dayOfWeek()) % 7;
      let firstSundayNovember = 1 + (7 - timestamp.date(y, 11, 1).dayOfWeek()) % 7;
      return ((m > 3 && m < 11) || (m == 3 && d >= secondSundayMarch) || (m == 11 && d < firstSundayNovember)) ? 420 : 480;
    }

    function barUtcDate(date) {
      return timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10]));
    }

    // 7:00 PM Mexicali on the reservation date
    function barDayStart(date) {
      let day = barUtcDate(date);
      return day + duration.value(barMxOffsetMinYMD(day.year(), day.month(), day.day()), 'm')
             + duration.value(19, 'h');
    }

    // 11:05 PM Mexicali on the reservation date (code-expiration cutoff)
    function barNightEnd(date) {
      let day = barUtcDate(date);
      return day + duration.value(barMxOffsetMinYMD(day.year(), day.month(), day.day()), 'm')
             + duration.value(23, 'h') + duration.value(5, 'm');
    }

    // The reservation window is over at 11:05 PM Mexicali.
    function barNightOver(date) {
      return request.time >= barNightEnd(date);
    }

    function barInServiceNight(data) {
      return (request.time >= barDayStart(data.date) && request.time < barNightEnd(data.date))
        // Short-lived records created directly by an administrator for scanner testing.
        // Public reservation/check-in creates reject these fields through their hasOnly() schemas.
        || (data.get('testMode', false) == true
            && data.testValidUntil is timestamp
            && data.createdAt is timestamp
            && data.testValidUntil <= data.createdAt + duration.value(4, 'h')
            && request.time < data.testValidUntil);
    }

    function barValidTime(time) {
      return time is string && time.matches('^((19|20|21|22):[0-5][0-9]|23:00)$');
    }

    function barLockId(date, table) {
      return date + '_' + string(table);
    }

    // House tables: always unavailable for online reservations.
    function barTableCanBeBooked(table) {
      return !(table in [1, 20, 21, 22]);
    }

    // Tables the user held before this request (0 if they never booked)
    function barCountBefore(uid) {
      return exists(barCountPath(uid)) ? get(barCountPath(uid)).data.count : 0;
    }

    // ---- Per-account limits (Mexicali calendar days) ----
    // A second table opens at midnight on the reservation date. Per account: up to 2 tables for today, 1 per future
    // date (the 2nd slot opens when the date arrives), at most 3 upcoming (today + future) in total.
    // Past nights and cancelled tables don't count. Checked on barUserActive/{uid}.res {orderNumber: date}:
    // at most 3 entries; a cancelled table leaves the index with its reservation, and a past night may
    // always be removed (the site removes the user's past nights right before booking).
    function barLimitDayStart(date) {
      let prev = barUtcDate(date) - duration.value(1, 'd');
      return barUtcDate(date) + duration.value(barMxOffsetMinYMD(prev.year(), prev.month(), prev.day()), 'm');
    }

    function barNightStarted(date) {
      return request.time >= barLimitDayStart(date);
    }

    function barDayCap(date) {
      return barNightStarted(date) ? 2 : 1;
    }

    function barEntryOn(m, k, i, date) {
      return (k.size() > i && m[k[i]] == date) ? 1 : 0;
    }

    // m after adding a table for `date`: max 3 entries, max 1 (future date) / 2 (today) on `date`
    function barActiveOk(m, date) {
      let k = m.keys();
      return k.size() <= 3
        && barEntryOn(m, k, 0, date) + barEntryOn(m, k, 1, date) + barEntryOn(m, k, 2, date) <= barDayCap(date);
    }

    // The reservation date (YYYY-MM-DD) must not be in the past
    // (1 day of slack so Mexicali "today" is always accepted whatever the UTC time)
    function barDateNotPast(date) {
      return timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10]))
             + duration.value(2, 'd') > request.time;
    }

    function barValidNewReservation(orderNumber) {
      let d = request.resource.data;
      return d.keys().hasOnly(['orderNumber', 'uid', 'email', 'name', 'date', 'time',
                               'guests', 'table', 'status', 'createdAt', 'validUntil', 'deadlineAt'])
        && d.keys().hasAll(['orderNumber', 'uid', 'email', 'name', 'date', 'time',
                            'guests', 'table', 'status', 'createdAt'])
        && orderNumber.matches('^[0-9]{6}$')
        && d.orderNumber == orderNumber
        && d.uid == request.auth.uid
        && d.email is string && d.email.size() <= 200
        && d.name is string && d.name.size() <= 200
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && barDateNotPast(d.date)
        && barValidTime(d.time)
        && (!('validUntil' in d) || d.validUntil == barNightEnd(d.date))
        && (!('deadlineAt' in d) || d.deadlineAt is timestamp) // old 2-hour field from Sept 28 pages; ignored
        // a service night that is already over can't be booked
        && barNightEnd(d.date) > request.time
        && d.guests is string && d.guests.size() <= 10
        && d.table is int && d.table >= 1 && d.table <= 50
        && barTableCanBeBooked(d.table)
        && d.status == 'active'
        && d.createdAt == request.time;
    }

    match /barReservations/{orderNumber} {
      // Owner only (and staff, to show the guest's name at check-in).
      // A missing doc may be probed so a fresh order number can be picked.
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      // Queries must be limited to the user's own reservations (where uid == auth.uid)
      allow list: if signedIn() && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
        && barValidNewReservation(orderNumber)
        // the table lock for this date+table is created in the same batch and points here
        && existsAfter(barLockPath(barLockId(request.resource.data.date, request.resource.data.table)))
        && !exists(barLockPath(barLockId(request.resource.data.date, request.resource.data.table)))
        && getAfter(barLockPath(barLockId(request.resource.data.date, request.resource.data.table))).data.orderNumber == orderNumber
        // the order is added to the user's active index in the same batch (that write checks the limits)
        && (!exists(barActivePath(request.auth.uid))
            || !(orderNumber in get(barActivePath(request.auth.uid)).data.res))
        && getAfter(barActivePath(request.auth.uid)).data.res[orderNumber] == request.resource.data.date
        && getAfter(barActivePath(request.auth.uid)).data.lastOrder == orderNumber;

      // Cancel: owner deletes the reservation, its lock and takes it out of the active index together
      // (tolerates a lock that is already gone or belongs to another order, and a reservation made
      // before the index existed)
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (!existsAfter(barLockPath(barLockId(resource.data.date, resource.data.table)))
            || getAfter(barLockPath(barLockId(resource.data.date, resource.data.table))).data.orderNumber != orderNumber)
        && (!existsAfter(barActivePath(request.auth.uid))
            || !(orderNumber in getAfter(barActivePath(request.auth.uid)).data.res));

      allow update: if signedIn() && (
        // (1) owner attaches a QR check-in code once, together with creating barCheckins/{code}
        (
          resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkinCode'])
          && !('checkinCode' in resource.data)
          && request.resource.data.checkinCode is string
          && barValidCode(request.resource.data.checkinCode)
          && !exists(barCheckinPath(request.resource.data.checkinCode))
          && existsAfter(barCheckinPath(request.resource.data.checkinCode))
          && getAfter(barCheckinPath(request.resource.data.checkinCode)).data.orderNumber == orderNumber
        ) ||
        // (2) staff check the guest in at the door: once only, from 7:00 PM until 11:05 PM
        (
          isAdmin()
          && resource.data.status == 'active'
          && resource.data.get('checkedIn', false) == false
          && barInServiceNight(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn', 'checkedInAt', 'checkedInBy'])
          && request.resource.data.checkedIn == true
          && request.resource.data.checkedInAt == request.time
          && request.resource.data.checkedInBy == request.auth.uid
        )
      );
    }

    match /barCheckins/{code} {
      // The reservation's owner (profile QR) and staff; nobody else can read a code
      allow get: if signedIn() && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
      // Staff can look a code up by its short part (BC-XXXXX typed at the door);
      // a guest can list only their own codes (profile "Registros" history)
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Owner creates the code for one of their own upcoming reservations (same batch sets checkinCode)
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['code', 'short', 'orderNumber', 'uid', 'date', 'time', 'guests', 'table', 'status', 'checkedIn', 'createdAt', 'validUntil', 'deadlineAt'])
        && (!('validUntil' in request.resource.data) || request.resource.data.validUntil == barNightEnd(request.resource.data.date))
        && (!('deadlineAt' in request.resource.data) || request.resource.data.deadlineAt is timestamp)
        && request.resource.data.keys().hasAll(['code', 'short', 'orderNumber', 'uid', 'date', 'time', 'guests', 'table', 'status', 'checkedIn', 'createdAt'])
        && barValidCode(code)
        && request.resource.data.code == code
        && request.resource.data.short == code[3:8]
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.checkedIn == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.orderNumber is string
        && exists(barResPath(request.resource.data.orderNumber))
        && get(barResPath(request.resource.data.orderNumber)).data.uid == request.auth.uid
        && !('checkinCode' in get(barResPath(request.resource.data.orderNumber)).data)
        && get(barResPath(request.resource.data.orderNumber)).data.date == request.resource.data.date
        && get(barResPath(request.resource.data.orderNumber)).data.time == request.resource.data.time
        && get(barResPath(request.resource.data.orderNumber)).data.guests == request.resource.data.guests
        && get(barResPath(request.resource.data.orderNumber)).data.table == request.resource.data.table
        && getAfter(barResPath(request.resource.data.orderNumber)).data.checkinCode == code;

      allow update: if signedIn() && (
        // staff check-in: one time only, active codes only, during the service night
        (
          isAdmin()
          && resource.data.status == 'active'
          && resource.data.checkedIn == false
          && barInServiceNight(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn', 'checkedInAt', 'checkedInBy', 'checkedInName', 'checkedInDevice'])
          && barCheckinWhoOk(request.resource.data)
          && request.resource.data.checkedIn == true
          && request.resource.data.checkedInAt == request.time
          && request.resource.data.checkedInBy == request.auth.uid
        ) ||
        // owner closes the code in the same batch that deletes the reservation (cancel / past-night cleanup)
        (
          resource.data.uid == request.auth.uid
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt'])
          && request.resource.data.closedAt == request.time
          && !existsAfter(barResPath(resource.data.orderNumber))
          && (request.resource.data.status == 'cancelled'
              || (request.resource.data.status == 'expired' && barNightOver(resource.data.date)))
        )
      );

      allow delete: if false;
    }

    // {key, name, first?, last?, role?, perms?, addedAt, addedBy, addedByName?, updatedAt?, updatedBy?}
    function barNameShapeOk(nameKey) {
      let d = request.resource.data;
      return d.keys().hasOnly(['key', 'name', 'first', 'last', 'role', 'perms', 'addedAt', 'addedBy', 'addedByName'])
        && d.keys().hasAll(['key', 'name', 'addedAt', 'addedBy'])
        && nameKey.size() <= 80
        && nameKey.matches("^[a-z0-9]([a-z0-9 .'-]*[a-z0-9.])?$")
        && !nameKey.matches('.*  .*')
        && d.key == nameKey
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && (!('first' in d) || (d.first is string && d.first.size() <= 40))
        && (!('last' in d) || (d.last is string && d.last.size() <= 40))
        && (!('role' in d) || (d.role is string && d.role.size() <= 40))
        && (!('perms' in d) || barPermsOk(d.perms))
        && d.addedAt == request.time
        && d.addedBy == request.auth.token.email;
    }

    match /barStaffNames/{nameKey} {
      // The owners see the whole list; the shared login may look up one exact name (the name prompt) and,
      // while a privileged name is acting, see the list («Personal» limited to its privileges)
      allow get: if barOwner() || (signedIn() && barIsSharedAccount());
      allow list: if barOwner() || barSharedCanAny();

      // Owners add anyone with any role / privileges. A name with «Agregar personal» adds people without
      // privileges only (granting privileges is for the owners), signed with its own name.
      allow create: if barNameShapeOk(nameKey) && (
        (barOwner() && !('addedByName' in request.resource.data))
        || (barSharedCan('add')
            && request.resource.data.get('perms', []).size() == 0
            && request.resource.data.addedByName
               == get(barSessionPath(request.auth.uid)).data.devices[get(barSessionPath(request.auth.uid)).data.actor].name)
      );

      // Only the owners edit a person's role and privileges (the name itself never changes)
      allow update: if barOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'perms', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('role', '') is string && request.resource.data.get('role', '').size() <= 40
        && barPermsOk(request.resource.data.get('perms', []))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;

      // Owners remove anyone; a name with «Quitar personal» removes only people without privileges
      allow delete: if barOwner()
        || (barSharedCan('remove') && resource.data.get('perms', []).size() == 0);
    }

    // Shared login session doc: devices = { deviceId: { nameKey, name, at } }. A device adds its own entry
    // (authorized name, canonical spelling from barStaffNames) or removes it (Salir). Signing in may also
    // reset the map to just this device (clears devices that never signed out).
    function barSessionShapeOk(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'devices', 'lastDevice', 'lastLoginAt', 'actor', 'kicked'])
        && request.resource.data.keys().hasAll(['uid', 'devices', 'lastDevice', 'lastLoginAt'])
        && request.resource.data.uid == uid
        && request.resource.data.devices is map
        && request.resource.data.devices.size() <= 50
        && request.resource.data.lastDevice is string
        && request.resource.data.lastDevice.matches('^[A-Za-z0-9]{16,40}$')
        && request.resource.data.lastLoginAt is timestamp;
    }

    function barSessionSignInOk() {
      let e = request.resource.data.devices[request.resource.data.lastDevice];
      return e is map
        && e.keys().hasOnly(['nameKey', 'name', 'at'])
        && e.keys().hasAll(['nameKey', 'name', 'at'])
        && e.nameKey is string && e.nameKey.size() <= 80
        && exists(barNamePath(e.nameKey))
        && e.name == get(barNamePath(e.nameKey)).data.name
        && e.at == request.time
        && request.resource.data.lastLoginAt == request.time;
    }

    // Signing in / Salir never sets who is acting or who was removed (those have their own updates below);
    // they may only keep them or drop them
    function barSessionKeepsExtras() {
      let d = request.resource.data;
      return (!('actor' in d) || (resource != null && d.actor == resource.data.get('actor', null)))
        && (!('kicked' in d) || (resource != null && d.kicked == resource.data.get('kicked', null)));
    }

    match /barStaffSessions/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || barOwner());
      allow list: if barOwner();

      allow create: if signedIn() && request.auth.uid == uid && barIsSharedAccount()
        && barSessionShapeOk(uid)
        && !('actor' in request.resource.data) && !('kicked' in request.resource.data)
        && request.resource.data.devices.keys().hasOnly([request.resource.data.lastDevice])
        && barSessionSignInOk();

      allow update: if signedIn() && request.auth.uid == uid && barIsSharedAccount()
        && barSessionShapeOk(uid)
        && barSessionKeepsExtras()
        && (
          // sign in on this device: add / replace its entry (or reset the map to just this device)
          (
            request.resource.data.lastDevice in request.resource.data.devices
            && barSessionSignInOk()
            && (request.resource.data.devices.diff(resource.data.devices).affectedKeys().hasOnly([request.resource.data.lastDevice])
                || request.resource.data.devices.keys().hasOnly([request.resource.data.lastDevice]))
          ) ||
          // Salir on this device: remove only its entry
          (
            !(request.resource.data.lastDevice in request.resource.data.devices)
            && request.resource.data.devices.diff(resource.data.devices).affectedKeys().hasOnly([request.resource.data.lastDevice])
            && request.resource.data.lastLoginAt == resource.data.lastLoginAt
          )
        );

      // a phone whose name has privileges becomes the one acting for the shared login (nothing else changes)
      allow update: if signedIn() && request.auth.uid == uid && barIsSharedAccount()
        && barSessionShapeOk(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actor'])
        && barActorPerms(request.resource.data).size() > 0;

      // a name with «Quitar personal» removed someone: take that person's phone out of the session, one per update
      // (kicked = its device id; its name must be gone already)
      allow update: if signedIn() && request.auth.uid == uid && barIsSharedAccount()
        && barSessionShapeOk(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devices', 'kicked'])
        && request.resource.data.kicked is string
        && request.resource.data.kicked in resource.data.devices
        && request.resource.data.devices.diff(resource.data.devices).affectedKeys().hasOnly([request.resource.data.kicked])
        && !(request.resource.data.kicked in request.resource.data.devices)
        && !exists(barNamePath(resource.data.devices[request.resource.data.kicked].nameKey))
        && 'remove' in barActorPerms(resource.data);

      // the owner removed a name in «Personal»: he may take entries out of the map (nothing else changes)
      allow update: if barOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devices'])
        && request.resource.data.devices.diff(resource.data.devices).addedKeys().size() == 0
        && request.resource.data.devices.diff(resource.data.devices).changedKeys().size() == 0;

      allow delete: if barOwner();
    }

    // Presence heartbeat: { kind, uid, device, ref, name, online, lastSeen }. lastSeen is always server time.
    // Shared login (s_{device}): ref/name must be this device's session entry; "online" also needs the entry
    // to be fresh and the name still on the list. Google staff (g_{uid}_{device}): ref = own email.
    function barPresenceShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'uid', 'device', 'ref', 'name', 'online', 'lastSeen'])
        && d.keys().hasAll(['kind', 'uid', 'device', 'ref', 'name', 'online', 'lastSeen'])
        && d.uid == request.auth.uid
        && d.device is string && d.device.matches('^[A-Za-z0-9]{16,40}$')
        && d.ref is string && d.name is string && d.name.size() <= 100
        && d.online is bool
        && d.lastSeen == request.time;
    }

    function barPresenceSharedOk(pid) {
      let d = request.resource.data;
      let s = get(barSessionPath(request.auth.uid)).data;
      return d.kind == 'shared'
        && pid == 's_' + d.device
        && barIsSharedAccount()
        && exists(barSessionPath(request.auth.uid))
        && d.device in s.devices
        && d.ref == s.devices[d.device].nameKey
        && d.name == s.devices[d.device].name
        && (d.online == false || (
          s.devices[d.device].at + duration.value(16, 'h') > request.time
          && exists(barNamePath(d.ref))
        ));
    }

    function barPresenceGoogleOk(pid) {
      let d = request.resource.data;
      return d.kind == 'google'
        && barGoogleVerified()
        && pid == 'g_' + request.auth.uid + '_' + d.device
        && d.ref == request.auth.token.email.lower()
        && (d.online == false || barGoogleStaff());
    }

    match /barStaffPresence/{pid} {
      allow get, list: if barOwner() || barSharedCan('presence');
      allow create, update: if signedIn() && barPresenceShapeOk()
        && (barPresenceSharedOk(pid) || barPresenceGoogleOk(pid));
      // owners; a name with «Quitar personal» only for a name it already removed
      allow delete: if barOwner()
        || (barSharedCan('remove') && resource.data.kind == 'shared' && !exists(barNamePath(resource.data.ref)));
    }

    // «Mesas» (staff app): tables already checked in tonight. Written only inside the staff check-in transaction
    // (the reservation goes from not checked in to checked in in the same request, same date / table / time);
    // a table re-booked after a cancellation may be overwritten by the new check-in. No names or emails.
    function barSeatedOk(sid) {
      let d = request.resource.data;
      return isAdmin()
        && d.keys().hasOnly(['date', 'table', 'time', 'orderNumber', 'at'])
        && d.keys().hasAll(['date', 'table', 'time', 'orderNumber', 'at'])
        && d.orderNumber is string && d.orderNumber.matches('^[0-9]{6}$')
        && d.date is string && d.table is int && d.time is string
        && sid == barLockId(d.date, d.table)
        && d.at == request.time
        && exists(barResPath(d.orderNumber))
        && get(barResPath(d.orderNumber)).data.get('checkedIn', false) == false
        && getAfter(barResPath(d.orderNumber)).data.checkedIn == true
        && getAfter(barResPath(d.orderNumber)).data.date == d.date
        && getAfter(barResPath(d.orderNumber)).data.table == d.table
        && getAfter(barResPath(d.orderNumber)).data.time == d.time;
    }

    match /barTableSeated/{sid} {
      allow get, list: if isAdmin();
      allow create: if barSeatedOk(sid);
      allow update: if barSeatedOk(sid) && resource.data.orderNumber != request.resource.data.orderNumber;
      allow delete: if false;
    }

    match /barAdmins/{uid} {
      // each user can check whether they are staff; the list is edited only in the Firebase console
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /barStaffEmails/{email} {
      // The owner sees and edits the whole list (staff app "Personal" panel)
      allow get, list: if barOwner();
      // A Google-signed-in user may look up their own entry (to open the scanner)
      allow get: if barGoogleVerified() && request.auth.token.email.lower() == email;

      // Owner adds one person: document id = lower-cased email, optional display name
      allow create: if barOwner()
        && request.resource.data.keys().hasOnly(['email', 'name', 'addedAt', 'addedBy'])
        && request.resource.data.keys().hasAll(['email', 'name', 'addedAt', 'addedBy'])
        && email.size() <= 254
        && email.matches('^[a-z0-9._%+-]+@[a-z0-9-]+([.][a-z0-9-]+)*[.][a-z]{2,}$')
        && !barOwnerEmail(email)
        && request.resource.data.email == email
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.addedAt == request.time
        && request.resource.data.addedBy == request.auth.token.email;

      // Owner removes access; entries are never edited in place (remove + add again)
      allow delete: if barOwner();
      allow update: if false;
    }

    match /barTableLocks/{lockId} {
      // Public so the seating chart can show taken tables; holds no personal data
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['date', 'table', 'time', 'orderNumber', 'createdAt', 'validUntil', 'deadlineAt'])
        && (!('validUntil' in request.resource.data) || request.resource.data.validUntil == barNightEnd(request.resource.data.date))
        && (!('deadlineAt' in request.resource.data) || request.resource.data.deadlineAt is timestamp)
        && request.resource.data.keys().hasAll(['date', 'table', 'time', 'orderNumber', 'createdAt'])
        && request.resource.data.date is string
        && request.resource.data.table is int
        && request.resource.data.time is string && request.resource.data.time.size() <= 10
        && request.resource.data.orderNumber is string
        && request.resource.data.createdAt == request.time
        && lockId == barLockId(request.resource.data.date, request.resource.data.table)
        // only together with a brand-new reservation of this user for the same date+table
        && !exists(barResPath(request.resource.data.orderNumber))
        && existsAfter(barResPath(request.resource.data.orderNumber))
        && getAfter(barResPath(request.resource.data.orderNumber)).data.uid == request.auth.uid
        && getAfter(barResPath(request.resource.data.orderNumber)).data.date == request.resource.data.date
        && getAfter(barResPath(request.resource.data.orderNumber)).data.table == request.resource.data.table;

      // Only removed together with the owner's reservation (cancel)
      allow delete: if signedIn()
        && get(barResPath(resource.data.orderNumber)).data.uid == request.auth.uid
        && !existsAfter(barResPath(resource.data.orderNumber));

      allow update: if false; // a taken table can't be overwritten
    }

    // Active index: res = {orderNumber: date} of the user's tables that still count. One entry is added
    // per booking (with the new reservation, limits checked on the result) or removed per cancel (with
    // the reservation deleted); a past night or an entry without a reservation may also be removed alone.
    function barActiveAdd(uid, before) {
      let after = request.resource.data.res;
      let o = request.resource.data.lastOrder;
      return after.diff(before).addedKeys().hasOnly([o])
        && after.diff(before).addedKeys().size() == 1
        && after.diff(before).changedKeys().size() == 0
        && after.diff(before).removedKeys().size() == 0
        && !exists(barResPath(o))
        && existsAfter(barResPath(o))
        && getAfter(barResPath(o)).data.uid == uid
        && getAfter(barResPath(o)).data.date == after[o]
        && barActiveOk(after, after[o]);
    }

    function barActiveRemove(uid, before) {
      let after = request.resource.data.res;
      let o = request.resource.data.lastOrder;
      return after.diff(before).removedKeys().hasOnly([o])
        && after.diff(before).removedKeys().size() == 1
        && after.diff(before).addedKeys().size() == 0
        && after.diff(before).changedKeys().size() == 0
        && (!exists(barResPath(o))
            || (get(barResPath(o)).data.uid == uid && !existsAfter(barResPath(o)))
            || barNightOver(before[o]));
    }

    match /barUserActive/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['res', 'lastOrder', 'updatedAt'])
        && request.resource.data.keys().hasAll(['res', 'lastOrder', 'updatedAt'])
        && request.resource.data.res is map
        && request.resource.data.lastOrder is string
        && request.resource.data.updatedAt == request.time
        && (barActiveAdd(uid, resource == null ? {} : resource.data.res)
            || barActiveRemove(uid, resource == null ? {} : resource.data.res));

      allow delete: if false;
    }

    // Legacy counter of the old 2-per-account limit (the site no longer writes it; kept so pages cached
    // before the change fail cleanly instead of leaving half-written bookings)
    match /barUserCounts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // +1 only together with a new reservation of this user (max 2),
      // -1 only together with deleting one of this user's reservations
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['count', 'lastOrder', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.lastOrder is string
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.count == barCountBefore(uid) + 1
            && request.resource.data.count <= 2
            && !exists(barResPath(request.resource.data.lastOrder))
            && existsAfter(barResPath(request.resource.data.lastOrder))
            && getAfter(barResPath(request.resource.data.lastOrder)).data.uid == uid
          ) || (
            request.resource.data.count == barCountBefore(uid) - 1
            && request.resource.data.count >= 0
            && exists(barResPath(request.resource.data.lastOrder))
            && get(barResPath(request.resource.data.lastOrder)).data.uid == uid
            && !existsAfter(barResPath(request.resource.data.lastOrder))
          )
        );

      allow delete: if false;
    }

    // Everything else stays denied (no match = no access).
  }
}
